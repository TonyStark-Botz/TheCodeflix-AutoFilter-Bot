modules = ["python-3.10", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cacert", "ffmpeg", "ffmpeg-full", "freetype", "gettext", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
PORT = "8083"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Auto Filter Bot"
mode = "parallel"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python bot.py"

[[workflows.workflow]]
name = "Auto Filter Bot"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python bot.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Auto Filter Bot"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8083
externalPort = 3000

[deployment]
deploymentTarget = "vm"
run = ["python", "bot.py"]
